def test_login_user():
    response = client.post(
        "/users/login",
        data={
            "username": "testuser_api",
            "password": "Test@12345",
        },
    )

    assert response.status_code == 200

    data = response.json()

    assert "access_token" in data
    assert data["token_type"] == "bearer"
    assert len(data["access_token"]) > 0